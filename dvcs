#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
config="${root}/.dvcs/install.env"
if [[ ! -f "${config}" ]]; then
    echo "not installed; run ./install.sh --profile local --accelerator auto" >&2
    exit 2
fi
# Job scripts and interactive callers may override the install-time defaults.
runtime_accelerator="${DVCS_ACCELERATOR-}"
runtime_accelerator_set="${DVCS_ACCELERATOR+x}"
runtime_workspace="${DVCS_WORKSPACE-}"
runtime_workspace_set="${DVCS_WORKSPACE+x}"
runtime_results="${DVCS_RESULTS-}"
runtime_results_set="${DVCS_RESULTS+x}"
runtime_cache="${DVCS_CACHE-}"
runtime_cache_set="${DVCS_CACHE+x}"
runtime_database="${DVCS_DATABASE-}"
runtime_database_set="${DVCS_DATABASE+x}"
# shellcheck disable=SC1090
source "${config}"
[[ -n "${runtime_accelerator_set}" ]] && DVCS_ACCELERATOR="${runtime_accelerator}"
[[ -n "${runtime_workspace_set}" ]] && DVCS_WORKSPACE="${runtime_workspace}"
[[ -n "${runtime_results_set}" ]] && DVCS_RESULTS="${runtime_results}"
[[ -n "${runtime_cache_set}" ]] && DVCS_CACHE="${runtime_cache}"
[[ -n "${runtime_database_set}" ]] && DVCS_DATABASE="${runtime_database}"

if [[ "${DVCS_PROFILE}" == jlab_ifarm ]]; then
    doctor_command=false
    skip_argument=false
    for argument in "$@"; do
        if [[ "${skip_argument}" == true ]]; then
            skip_argument=false
            continue
        fi
        case "${argument}" in
            --bridge) skip_argument=true ;;
            --*) ;;
            doctor) doctor_command=true; break ;;
            *) break ;;
        esac
    done
    host_name="$(hostname -s)"
    if [[ "${doctor_command}" == true ]] && \
       [[ "${host_name}" == ifarm* ]] && \
       [[ -z "${SLURM_JOB_ID:-}" ]]; then
        gpu_doctor="${DVCS_IFARM_GPU_DOCTOR:-ask}"
        if [[ "${gpu_doctor}" == ask ]]; then
            if [[ -t 0 ]]; then
                read -r -p "ifarm detected; run doctor in a Slurm GPU allocation? [y/N] " gpu_doctor
            else
                gpu_doctor=no
            fi
        fi
        case "${gpu_doctor,,}" in
            y|yes)
                command -v srun >/dev/null 2>&1 || {
                    echo "srun is required for the JLab GPU doctor" >&2
                    exit 69
                }
                jlab_account="${JLAB_ACCOUNT:-}"
                jlab_gpu_partition="${JLAB_GPU_PARTITION:-gpu}"
                resources_file="${root}/jobs/jlab_ifarm/resources.env"
                if [[ -f "${resources_file}" ]]; then
                    if [[ -z "${jlab_account}" ]]; then
                        jlab_account="$(
                          unset JLAB_ACCOUNT
                          # shellcheck disable=SC1090
                          source "${resources_file}"
                          printf '%s' "${JLAB_ACCOUNT:-}"
                        )"
                    fi
                    if [[ -z "${JLAB_GPU_PARTITION:-}" ]]; then
                        jlab_gpu_partition="$(
                          unset JLAB_GPU_PARTITION
                          # shellcheck disable=SC1090
                          source "${resources_file}"
                          printf '%s' "${JLAB_GPU_PARTITION:-gpu}"
                        )"
                    fi
                fi
                [[ "${jlab_account}" == REQUIRED_* ]] && jlab_account=""
                srun_args=(
                  --partition="${jlab_gpu_partition}"
                  --nodes=1 --ntasks=1 --cpus-per-task=2
                  --mem=8G --gres=gpu:1 --time=00:15:00 --unbuffered
                )
                [[ -n "${jlab_account}" ]] && \
                  srun_args+=(--account="${jlab_account}")
                echo "requesting a short Slurm GPU allocation for doctor" >&2
                exec srun "${srun_args[@]}" env \
                  DVCS_ACCELERATOR=cuda DVCS_IFARM_GPU_DOCTOR=no \
                  "${root}/dvcs" "$@"
                ;;
            n|no|"") ;;
            *)
                echo "DVCS_IFARM_GPU_DOCTOR must be ask, yes, or no" >&2
                exit 64
                ;;
        esac
    fi
    apptainer_gpu_args=()
    if [[ "${DVCS_ACCELERATOR}" == cuda ]]; then
        if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] || \
           [[ "${CUDA_VISIBLE_DEVICES}" == NoDevFiles ]]; then
            echo "CUDA requested for jlab_ifarm, but no Slurm GPU allocation is visible" >&2
            echo "request a GPU and run through salloc/srun or a supplied GPU sbatch template" >&2
            exit 69
        fi
        apptainer_gpu_args=(--nv)
    elif [[ "${DVCS_ACCELERATOR}" == auto ]] && \
         [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]] && \
         [[ "${CUDA_VISIBLE_DEVICES}" != NoDevFiles ]]; then
        apptainer_gpu_args=(--nv)
    fi
    apptainer_env_args=(
      --env "DVCS_ACCELERATOR=${DVCS_ACCELERATOR}"
      --env "DVCS_IMAGE_DIGEST=${DVCS_IMAGE_DIGEST}"
    )
    if [[ -v SLURM_JOB_ID ]]; then
        apptainer_env_args+=(--env "SLURM_JOB_ID=${SLURM_JOB_ID}")
        if [[ -v SLURM_CPUS_PER_TASK ]]; then
            apptainer_env_args+=(
              --env "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK}"
            )
        fi
    fi
    if ((${#apptainer_gpu_args[@]})); then
        # --cleanenv removes Slurm's host variable. Forward it explicitly so
        # CUDA programs use exactly the devices assigned by the scheduler.
        apptainer_env_args+=(--env "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}")
    fi
    exec apptainer run --cleanenv "${apptainer_gpu_args[@]}" \
      --bind "${DVCS_WORKSPACE}:/workspace" --bind "${DVCS_RESULTS}:/results" \
      --bind "${DVCS_CACHE}:/cache" --bind "${DVCS_DATABASE}:/database:ro" \
      "${apptainer_env_args[@]}" "${DVCS_IMAGE}" "$@"
fi
container_gpu_args=()
container_engine_args=()
if [[ "${DVCS_ENGINE}" == podman ]]; then
    container_engine_args=(--security-opt label=disable)
fi
if [[ "${DVCS_ACCELERATOR}" == cuda ]] || \
   { [[ "${DVCS_ACCELERATOR}" == auto ]] && [[ -n "${DVCS_CONTAINER_GPU_ARGS:-}" ]]; }; then
    if [[ "${DVCS_ENGINE}" == podman ]]; then
        container_gpu_args=(--device nvidia.com/gpu=all)
    else
        container_gpu_args=(--gpus all)
    fi
fi
exec "${DVCS_ENGINE}" run --rm --user "$(id -u):$(id -g)" \
  "${container_engine_args[@]}" \
  --cpuset-cpus "$(python3 -c 'import os; print(",".join(map(str,sorted(os.sched_getaffinity(0)))))')" \
  "${container_gpu_args[@]}" \
  -e "DVCS_ACCELERATOR=${DVCS_ACCELERATOR}" \
  -e "DVCS_IMAGE_DIGEST=${DVCS_IMAGE_DIGEST}" \
  -v "${DVCS_WORKSPACE}:/workspace" -v "${DVCS_RESULTS}:/results" \
  -v "${DVCS_CACHE}:/cache" -v "${DVCS_DATABASE}:/database:ro" \
  "${DVCS_IMAGE}" "$@"
