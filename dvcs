#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
config="${root}/.dvcs/install.env"
if [[ ! -f "${config}" ]]; then
    echo "not installed; run ./install.sh --profile local --accelerator auto" >&2
    exit 2
fi
# Job scripts and interactive callers may override the install-time defaults.
runtime_accelerator="${DVCS_ACCELERATOR-}"
runtime_accelerator_set="${DVCS_ACCELERATOR+x}"
runtime_workspace="${DVCS_WORKSPACE-}"
runtime_workspace_set="${DVCS_WORKSPACE+x}"
runtime_results="${DVCS_RESULTS-}"
runtime_results_set="${DVCS_RESULTS+x}"
runtime_cache="${DVCS_CACHE-}"
runtime_cache_set="${DVCS_CACHE+x}"
runtime_database="${DVCS_DATABASE-}"
runtime_database_set="${DVCS_DATABASE+x}"
# shellcheck disable=SC1090
source "${config}"
[[ -n "${runtime_accelerator_set}" ]] && DVCS_ACCELERATOR="${runtime_accelerator}"
[[ -n "${runtime_workspace_set}" ]] && DVCS_WORKSPACE="${runtime_workspace}"
[[ -n "${runtime_results_set}" ]] && DVCS_RESULTS="${runtime_results}"
[[ -n "${runtime_cache_set}" ]] && DVCS_CACHE="${runtime_cache}"
[[ -n "${runtime_database_set}" ]] && DVCS_DATABASE="${runtime_database}"

if [[ "${DVCS_PROFILE}" == jlab_ifarm ]]; then
    gpu_command=""
    command_index=-1
    arguments=("$@")
    skip_argument=false
    for index in "${!arguments[@]}"; do
        argument="${arguments[index]}"
        if [[ "${skip_argument}" == true ]]; then
            skip_argument=false
            continue
        fi
        case "${argument}" in
            --bridge) skip_argument=true ;;
            --*) ;;
            doctor|train|evaluate)
                gpu_command="${argument}"
                command_index="${index}"
                break
                ;;
            *) break ;;
        esac
    done
    host_name="$(hostname -s)"
    if [[ -n "${gpu_command}" ]] && \
       [[ "${host_name}" == ifarm* ]] && \
       [[ -z "${SLURM_JOB_ID:-}" ]]; then
        if [[ "${gpu_command}" == doctor ]]; then
            prompt_variable=DVCS_IFARM_GPU_DOCTOR
            gpu_cpus=2
            gpu_memory=8G
            gpu_time=00:15:00
        elif [[ "${gpu_command}" == train ]]; then
            prompt_variable=DVCS_IFARM_GPU_TRAIN
            gpu_cpus=8
            gpu_memory=64G
            gpu_time=12:00:00
        else
            prompt_variable=DVCS_IFARM_EVALUATE_MATCH_TRAINING
            project="${arguments[command_index + 1]:-}"
            profile=quick
            for ((index = command_index + 2; index < ${#arguments[@]}; index++)); do
                case "${arguments[index]}" in
                    --profile)
                        ((index++))
                        profile="${arguments[index]:-}"
                        ;;
                    --profile=*) profile="${arguments[index]#--profile=}" ;;
                esac
            done
            training_summary="${DVCS_WORKSPACE}/${project}/results/${profile}/training/training_summary.json"
            if [[ ! -f "${training_summary}" ]]; then
                echo "cannot determine training device; missing ${training_summary}" >&2
                exit 66
            fi
            training_metadata="$({ python3 - "${training_summary}" <<'PY'
import json
import sys

summary = json.load(open(sys.argv[1], encoding="utf-8"))
device = summary.get("neural_device", {})
resolved = str(device.get("resolved", "")).split(":", 1)[0].lower()
if resolved not in {"cpu", "cuda"}:
    raise SystemExit("training summary has no resolved CPU/CUDA device")
name = str(device.get("cuda_device_name") or "")
threads = summary.get("training_runtime", {}).get("cpu_threads")
if not isinstance(threads, int):
    members = summary.get("members", {})
    values = {
        item.get("torch_num_threads")
        for item in members.values()
        if isinstance(item, dict) and isinstance(item.get("torch_num_threads"), int)
    }
    if resolved == "cpu" and len(values) == 1:
        threads = values.pop()
    elif resolved == "cuda":
        threads = 8  # Legacy JLab GPU-training default.
if not isinstance(threads, int) or not 1 <= threads <= 256:
    raise SystemExit("training summary has no valid CPU-thread count")
print(resolved)
print(name)
print(threads)
PY
            } 2>&1)" || {
                echo "cannot read training device: ${training_metadata}" >&2
                exit 65
            }
            mapfile -t training_fields <<<"${training_metadata}"
            training_accelerator="${training_fields[0]}"
            training_device_name="${training_fields[1]}"
            gpu_cpus="${training_fields[2]}"
            gpu_memory=64G
            gpu_time=12:00:00
            if [[ "${training_accelerator}" == cuda ]]; then
                training_label="GPU"
                [[ -n "${training_device_name}" ]] && \
                  training_label+=" (${training_device_name})"
            else
                training_label="CPU"
            fi
            echo "training used ${training_label} with ${gpu_cpus} configured CPU threads" >&2
        fi
        if [[ -v "${prompt_variable}" ]]; then
            gpu_choice="${!prompt_variable}"
        else
            gpu_choice=ask
        fi
        if [[ "${gpu_choice}" == ask ]]; then
            if [[ -t 0 ]]; then
                if [[ "${gpu_command}" == evaluate ]]; then
                    read -r -p "evaluate with same ${training_label} setup (recommended; no cancels)? [Y/n] " gpu_choice
                    gpu_choice="${gpu_choice:-yes}"
                else
                    read -r -p "ifarm detected; run ${gpu_command} in a Slurm GPU allocation? [y/N] " gpu_choice
                fi
            else
                if [[ "${gpu_command}" == evaluate ]]; then
                    echo "set ${prompt_variable}=yes for noninteractive matching evaluation" >&2
                    exit 64
                fi
                gpu_choice=no
            fi
        fi
        case "${gpu_choice,,}" in
            y|yes)
                if [[ "${gpu_command}" == evaluate ]] && \
                   [[ "${training_accelerator}" == cpu ]]; then
                    export DVCS_ACCELERATOR=cpu
                    export DVCS_CPU_THREADS="${gpu_cpus}"
                    gpu_choice=no
                    echo "evaluating on CPU to match training" >&2
                fi
                ;;
            n|no|"")
                if [[ "${gpu_command}" == evaluate ]]; then
                    echo "evaluation cancelled; matching training device is required by the result contract" >&2
                    exit 0
                fi
                ;;
            *)
                echo "${prompt_variable} must be ask, yes, or no" >&2
                exit 64
                ;;
        esac
        if [[ "${gpu_choice,,}" == y || "${gpu_choice,,}" == yes ]]; then
                command -v srun >/dev/null 2>&1 || {
                    echo "srun is required for JLab GPU ${gpu_command}" >&2
                    exit 69
                }
                jlab_account="${JLAB_ACCOUNT:-}"
                jlab_gpu_partition="${JLAB_GPU_PARTITION:-gpu}"
                resources_file="${root}/jobs/jlab_ifarm/resources.env"
                if [[ -f "${resources_file}" ]]; then
                    if [[ -z "${jlab_account}" ]]; then
                        jlab_account="$(
                          unset JLAB_ACCOUNT
                          # shellcheck disable=SC1090
                          source "${resources_file}"
                          printf '%s' "${JLAB_ACCOUNT:-}"
                        )"
                    fi
                    if [[ -z "${JLAB_GPU_PARTITION:-}" ]]; then
                        jlab_gpu_partition="$(
                          unset JLAB_GPU_PARTITION
                          # shellcheck disable=SC1090
                          source "${resources_file}"
                          printf '%s' "${JLAB_GPU_PARTITION:-gpu}"
                        )"
                    fi
                fi
                [[ "${jlab_account}" == REQUIRED_* ]] && jlab_account=""
                srun_args=(
                  --partition="${jlab_gpu_partition}"
                  --nodes=1 --ntasks=1 --cpus-per-task="${gpu_cpus}"
                  --mem="${gpu_memory}" --gres=gpu:1
                  --time="${gpu_time}" --unbuffered
                )
                [[ -n "${jlab_account}" ]] && \
                  srun_args+=(--account="${jlab_account}")
                echo "requesting a Slurm GPU allocation for ${gpu_command}" >&2
                exec srun "${srun_args[@]}" env \
                  DVCS_ACCELERATOR=cuda "${prompt_variable}=no" \
                  "${root}/dvcs" "$@"
        fi
    fi
    apptainer_gpu_args=()
    if [[ "${DVCS_ACCELERATOR}" == cuda ]]; then
        if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] || \
           [[ "${CUDA_VISIBLE_DEVICES}" == NoDevFiles ]]; then
            echo "CUDA requested for jlab_ifarm, but no Slurm GPU allocation is visible" >&2
            echo "request a GPU and run through salloc/srun or a supplied GPU sbatch template" >&2
            exit 69
        fi
        apptainer_gpu_args=(--nv)
    elif [[ "${DVCS_ACCELERATOR}" == auto ]] && \
         [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]] && \
         [[ "${CUDA_VISIBLE_DEVICES}" != NoDevFiles ]]; then
        apptainer_gpu_args=(--nv)
    fi
    apptainer_env_args=(
      --env "DVCS_ACCELERATOR=${DVCS_ACCELERATOR}"
      --env "DVCS_IMAGE_DIGEST=${DVCS_IMAGE_DIGEST}"
    )
    if [[ -n "${DVCS_CPU_THREADS:-}" ]]; then
        apptainer_env_args+=(--env "DVCS_CPU_THREADS=${DVCS_CPU_THREADS}")
    fi
    if [[ -v SLURM_JOB_ID ]]; then
        apptainer_env_args+=(--env "SLURM_JOB_ID=${SLURM_JOB_ID}")
        if [[ -v SLURM_CPUS_PER_TASK ]]; then
            apptainer_env_args+=(
              --env "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK}"
            )
        fi
    fi
    if ((${#apptainer_gpu_args[@]})); then
        # --cleanenv removes Slurm's host variable. Forward it explicitly so
        # CUDA programs use exactly the devices assigned by the scheduler.
        apptainer_env_args+=(--env "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}")
    fi
    exec apptainer run --cleanenv "${apptainer_gpu_args[@]}" \
      --bind "${DVCS_WORKSPACE}:/workspace" --bind "${DVCS_RESULTS}:/results" \
      --bind "${DVCS_CACHE}:/cache" --bind "${DVCS_DATABASE}:/database:ro" \
      "${apptainer_env_args[@]}" "${DVCS_IMAGE}" "$@"
fi
container_gpu_args=()
container_engine_args=()
if [[ "${DVCS_ENGINE}" == podman ]]; then
    container_engine_args=(--security-opt label=disable)
fi
if [[ "${DVCS_ACCELERATOR}" == cuda ]] || \
   { [[ "${DVCS_ACCELERATOR}" == auto ]] && [[ -n "${DVCS_CONTAINER_GPU_ARGS:-}" ]]; }; then
    if [[ "${DVCS_ENGINE}" == podman ]]; then
        container_gpu_args=(--device nvidia.com/gpu=all)
    else
        container_gpu_args=(--gpus all)
    fi
fi
exec "${DVCS_ENGINE}" run --rm --user "$(id -u):$(id -g)" \
  "${container_engine_args[@]}" \
  --cpuset-cpus "$(python3 -c 'import os; print(",".join(map(str,sorted(os.sched_getaffinity(0)))))')" \
  "${container_gpu_args[@]}" \
  -e "DVCS_ACCELERATOR=${DVCS_ACCELERATOR}" \
  -e "DVCS_IMAGE_DIGEST=${DVCS_IMAGE_DIGEST}" \
  -v "${DVCS_WORKSPACE}:/workspace" -v "${DVCS_RESULTS}:/results" \
  -v "${DVCS_CACHE}:/cache" -v "${DVCS_DATABASE}:/database:ro" \
  "${DVCS_IMAGE}" "$@"
