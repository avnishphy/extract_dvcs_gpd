Bootstrap: docker
From: ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

%files
    . /opt/dvcs/app

%post
    export DEBIAN_FRONTEND=noninteractive
    echo 'APT::Snapshot "20260801T000000Z";' > /etc/apt/apt.conf.d/50snapshot
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git build-essential gfortran cmake pkg-config autoconf automake libtool python3 python3-dev python3-venv libboost-json1.83-dev libcln-dev libsfml-dev libeigen3-dev libxml2-dev libboost-json1.83.0 libcln6 libsfml-system2.6 libxml2 libgfortran5
    rm -rf /var/lib/apt/lists/*
    export DVCS_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
    /opt/dvcs/app/scripts/build-native-source.sh /opt/dvcs
    mkdir -p /opt/dvcs/share/extract-dvcs-gpd
    dpkg-query -W > /opt/dvcs/share/extract-dvcs-gpd/dpkg-manifest.tsv
    mkdir -p /workspace /results /cache /database

%environment
    export PATH=/opt/dvcs/venv/bin:/opt/dvcs/bin:$PATH
    export LD_LIBRARY_PATH=/opt/dvcs/lib
    export DVCS_INFER_REPOSITORY_ROOT=/opt/dvcs/app
    export DVCS_WORKSPACE_ROOT=/workspace
    export DVCS_GPDDATABASE_ROOT=/database/gpddatabase
    export LHAPDF_DATA_PATH=/cache/lhapdf
    export MPLCONFIGDIR=/cache/matplotlib

%runscript
    exec /opt/dvcs/app/scripts/container-entrypoint.sh "$@"

%test
    /opt/dvcs/bin/partons_bridge --capabilities >/dev/null
    /opt/dvcs/venv/bin/python -c 'import extract_dvcs_cff, torch, sbi'
