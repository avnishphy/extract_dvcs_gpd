# Copy to resources.env and edit. Never commit credentials.
JLAB_ACCOUNT=REQUIRED_SET_YOUR_SLURM_ACCOUNT
DVCS_PROJECT=my-study
DVCS_CORPUS=my-corpus
DVCS_SELECTION=baseline
DVCS_REPOSITORY=/path/to/your/extract_dvcs_gpd
DVCS_WORKSPACE=/path/to/your/workspace
DVCS_RESULTS=/path/to/your/results
DVCS_CACHE=/path/to/your/large/cache
DVCS_DATABASE=/path/to/your/database-parent
# SWIF2 is the supported ifarm/farm submission interface. The JLAB_* settings
# below are retained only for the legacy direct-Slurm diagnostic scripts.
# Verified JLab SciComp partitions as of 2026-08-20.
JLAB_CPU_PARTITION=production
JLAB_GPU_PARTITION=gpu
# Wrapper resource policy. Values are command-line sbatch overrides, so this
# file is the single place to tune a campaign. "auto" caps training GPUs by
# both ensemble-member count and JLAB_MAX_GPUS_PER_JOB.
JLAB_MAX_GPUS_PER_JOB=4
JLAB_GPU_TYPE=
# Optional campaign label. Blank defaults to DVCS_PROJECT. The wrapper writes
# dvcs:TAG:STAGE into Slurm's Comment field.
JLAB_JOB_TAG=
# Scheduler stdout/stderr only. Scientific outputs remain under DVCS_RESULTS.
JLAB_SLURM_LOG_ROOT=/farm_out/%u
# Periodic one-line stdout heartbeat; 0 disables it.
JLAB_HEARTBEAT_SECONDS=300
JLAB_GENERATE_CPUS=128
# Prefix with per-cpu: to emit --mem-per-cpu instead of --mem.
JLAB_GENERATE_MEM=per-cpu:160M
JLAB_GENERATE_TIME=24:00:00
JLAB_SELECTION_CPUS=1
JLAB_SELECTION_MEM=4G
JLAB_SELECTION_TIME=00:30:00
JLAB_OPTIMIZE_GPUS=4
JLAB_OPTIMIZE_CPUS=8
JLAB_OPTIMIZE_MEM=64G
JLAB_OPTIMIZE_TIME=12:00:00
JLAB_TRAIN_GPUS=auto
JLAB_TRAIN_CPUS=8
JLAB_TRAIN_MEM=64G
JLAB_TRAIN_TIME=12:00:00
JLAB_EVALUATE_GPUS=1
JLAB_EVALUATE_CPUS=32
JLAB_EVALUATE_MEM=64G
JLAB_EVALUATE_TIME=12:00:00
JLAB_COMPARE_CPUS=1
JLAB_COMPARE_MEM=32G
JLAB_COMPARE_TIME=04:00:00
JLAB_HOLDOUT_CPUS=1
JLAB_HOLDOUT_MEM=32G
JLAB_HOLDOUT_TIME=12:00:00
JLAB_PLOT_CPUS=1
JLAB_PLOT_MEM=8G
JLAB_PLOT_TIME=01:00:00

# SWIF2 managed workflows. Scientific products are reaped to SWIF_OUTPUT_ROOT;
# scheduler stdout/stderr goes to SWIF_LOG_ROOT. Set SWIF_CORPUS_ARCHIVE to the
# portable corpus used by selection/training.
SWIF_SITE_NAME=jlab/enp
SWIF_CONSTRAINT=el9
SWIF_CORPUS_ARCHIVE=/path/to/portable-corpus.tar.gz
SWIF_OUTPUT_ROOT=/path/to/your/results/swif2
SWIF_LOG_ROOT=/farm_out/YOUR_USERNAME/dvcs
SWIF_MAX_CONCURRENT=64
SWIF_MAX_DISPATCHED=64
SWIF_HEARTBEAT_SECONDS=300
# CPU/memory/I/O and GPU utilization/VRAM/power sample cadence.
SWIF_METRICS_INTERVAL_SECONDS=30

SWIF_CORPUS_WORKER_CORES=16
SWIF_CORPUS_WORKER_RAM=32G
SWIF_CORPUS_WORKER_DISK=32G
SWIF_CORPUS_WORKER_TIME=12h
SWIF_CORPUS_MERGE_CORES=4
SWIF_CORPUS_MERGE_RAM=16G
SWIF_CORPUS_MERGE_DISK=64G
SWIF_CORPUS_MERGE_TIME=12h

# Per-stage requests. Override only from measured SWIF/Slurm accounting. The
# train default is deliberately 24G: the streaming materializer avoids the
# previous duplicate 5.4G context array, while retaining initial safety margin.
SWIF_SELECTION_CORES=1
SWIF_SELECTION_RAM=4G
SWIF_SELECTION_DISK=8G
SWIF_SELECTION_TIME=30m
SWIF_OPTIMIZE_CORES=8
SWIF_OPTIMIZE_RAM=32G
SWIF_OPTIMIZE_DISK=48G
SWIF_OPTIMIZE_TIME=12h
SWIF_OPTIMIZE_GPUS=1
SWIF_TRAIN_CORES=8
SWIF_TRAIN_RAM=24G
SWIF_TRAIN_DISK=48G
SWIF_TRAIN_TIME=12h
SWIF_TRAIN_GPUS=1
SWIF_EVALUATE_CORES=8
SWIF_EVALUATE_RAM=16G
SWIF_EVALUATE_DISK=48G
SWIF_EVALUATE_TIME=12h
SWIF_EVALUATE_GPUS=1
SWIF_COMPARE_CORES=2
SWIF_COMPARE_RAM=8G
SWIF_COMPARE_DISK=32G
SWIF_COMPARE_TIME=4h
SWIF_HOLDOUT_CORES=16
SWIF_HOLDOUT_RAM=16G
SWIF_HOLDOUT_DISK=48G
SWIF_HOLDOUT_TIME=12h
SWIF_PLOT_CORES=2
SWIF_PLOT_RAM=8G
SWIF_PLOT_DISK=32G
SWIF_PLOT_TIME=1h
